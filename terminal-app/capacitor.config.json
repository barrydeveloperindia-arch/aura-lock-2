{
    "appId": "com.auralock.terminal.v3",
    "appName": "EngLabs Attendance Tracker",
    "webDir": "dist",
    "server": {
        "androidScheme": "http",
        "cleartext": true
    },
    "android": {
        "allowMixedContent": true,
        "backgroundColor": "#0a0f1e",
        "overrideUserAgent": "EngLabs-Attendance-Tracker/1.0"
    },
    "plugins": {
        "NativeBiometric": {
            "reason": "Verify identity for attendance"
        },
        "Camera": {
            "permissions": [
                "camera"
            ]
        }
    }
}